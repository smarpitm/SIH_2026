{
  "name": "github_project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:indexes": "prisma db execute --file prisma/search-indexes.sql --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "worker": "tsx workers/worker-entry.ts",
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "seed:10k": "tsx prisma/seed-10k.ts",
    "openapi:check": "node scripts/check-openapi.mjs",
    "i18n:check": "tsx lib/i18n/check-parity.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@prisma/client": "^6.19.3",
    "bullmq": "^6.3.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.10",
    "next": "14.2.35",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^4.4.3",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
