DATABASE_URL="postgresql://pramanam:pramanam@localhost:5432/pramanam"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="dev-only-secret-change-me"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me"
ED25519_PRIVATE_KEY="" # base64 PKCS8, generated by Smarpit in S1 — DO NOT COMMIT REAL
ED25519_PUBLIC_KEY="" # base64 SPKI
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="pramanam"
S3_SECRET_KEY="pramanam123"
S3_BUCKET="pramanam-docs"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Payment mode: "demo" (default, mock — local/demo only) | anything else refuses
# to record payment until a real gateway is integrated. Production boots fail
# unless PAYMENT_MODE=demo AND ALLOW_DEMO_PAYMENT=true.
PAYMENT_MODE="demo"
# ALLOW_DEMO_PAYMENT="true" # only for demo deployments of a production build
# Vercel Cron: the cron runner sends `Authorization: Bearer $CRON_SECRET` to
# /api/v1/cron/expiry-scan (vercel.json `crons`). Generate with: openssl rand -hex 32
CRON_SECRET=""
# Set "true" only when the app sits behind a trusted proxy (Vercel/Render) so
# clientIp() may use x-forwarded-for for per-IP rate-limit keys.
TRUST_PROXY="false"